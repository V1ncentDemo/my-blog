---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_TITLE, categoryLabel } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部记录 · ${SITE_TITLE}`} description="按分类浏览全部记录" />
	</head>
	<body>
		<Header />
		<main>
			<h1>全部记录</h1>
			<nav class="cat-nav">
				<a href="#all">全部（{posts.length}）</a>
				{
					CATEGORIES.map((c) => {
						const n = posts.filter((p) => p.data.category === c.key).length;
						return <a href={`#${c.key}`}>{c.label}（{n}）</a>;
					})
				}
			</nav>

			<ul id="all" class="post-list">
				{
					posts.map((post) => (
						<li class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-content">
									<div class="card-top">
										<span class="cat">{categoryLabel(post.data.category)}</span>
										<span class="meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<span class="post-title">{post.data.title}</span>
								</div>
								{post.data.thumbnail && (
									<Image
										class="thumbnail"
										src={post.data.thumbnail}
										alt=""
										width={200}
										height={150}
										loading="lazy"
									/>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.cat-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0 0 2rem 0;
	}
	.cat-nav a {
		font-size: 0.9em;
		text-decoration: none;
		color: var(--accent-dark);
		background: rgba(var(--accent-soft), 0.6);
		border-radius: 999px;
		padding: 0.25em 1em;
		transition: background 0.15s ease;
	}
	.cat-nav a:hover {
		background: rgba(var(--accent-soft), 1);
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.card {
		background: var(--card-bg);
		border: 1px solid rgba(var(--accent-soft), 0.9);
		border-radius: var(--radius);
		box-shadow: var(--box-shadow);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(47, 107, 143, 0.16);
	}
	.card a {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1.1rem 1.4rem;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.card-content {
		flex: 1;
		min-width: 0;
	}
	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}
	.card:hover .post-title {
		color: var(--accent-dark);
	}
	.cat {
		font-size: 0.75em;
		color: var(--accent-dark);
		background: rgba(var(--accent-soft), 0.6);
		border-radius: 999px;
		padding: 0.2em 0.8em;
		white-space: nowrap;
	}
	.post-title {
		display: block;
		font-size: 1.2em;
		font-weight: 700;
		line-height: 1.35;
	}
	.meta {
		color: rgb(var(--gray));
		font-size: 0.85em;
		white-space: nowrap;
	}
	.thumbnail {
		width: 96px;
		height: 72px;
		flex: 0 0 96px;
		object-fit: cover;
		border-radius: 10px;
		box-shadow: 0 3px 10px rgba(47, 107, 143, 0.14);
	}
	@media (max-width: 520px) {
		.card a {
			gap: 0.75rem;
			padding: 0.9rem 1rem;
		}
		.thumbnail {
			width: 72px;
			height: 72px;
			flex-basis: 72px;
		}
	}
</style>
