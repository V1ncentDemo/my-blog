---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, categoryLabel } from '../consts';

// 取出全部记录，按发布日期从新到旧排序
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="cat">{categoryLabel(post.data.category)}</span>
								<span class="post-title">{post.data.title}</span>
							</a>
							<p class="meta">
								<FormattedDate date={post.data.pubDate} />
							</p>
							{post.data.description && <p class="excerpt">{post.data.description}</p>}
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}
	.intro h1 {
		font-size: 2.2em;
		margin-bottom: 0.3em;
	}
	.intro p {
		color: rgb(var(--gray));
		margin: 0;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		padding: 1.4rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list li:first-child {
		border-top: 1px solid rgb(var(--gray-light));
	}
	.post-list a {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.post-list a:hover .post-title {
		color: var(--accent);
	}
	.cat {
		flex: none;
		font-size: 0.75em;
		color: var(--accent);
		background: rgba(var(--gray-light), 60%);
		border-radius: 999px;
		padding: 0.1em 0.7em;
		white-space: nowrap;
	}
	.post-title {
		font-size: 1.25em;
		font-weight: 700;
	}
	.meta {
		margin: 0.4rem 0 0 0;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.excerpt {
		margin: 0.3rem 0 0 0;
		color: rgb(var(--gray-dark));
	}
</style>
