---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, categoryLabel } from '../consts';

// 取出全部记录，按发布日期从新到旧排序
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-content">
									<div class="card-top">
										<span class="cat">{categoryLabel(post.data.category)}</span>
										<span class="meta">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<span class="post-title">{post.data.title}</span>
									{post.data.description && <p class="excerpt">{post.data.description}</p>}
								</div>
								{post.data.thumbnail && (
									<Image
										class="thumbnail"
										src={post.data.thumbnail}
										alt=""
										width={240}
										height={180}
										loading="lazy"
									/>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}
	.intro h1 {
		font-size: 2.3em;
		margin-bottom: 0.3em;
		color: var(--accent-dark);
	}
	.intro p {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 1.05em;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}
	.card {
		background: var(--card-bg);
		border: 1px solid rgba(var(--accent-soft), 0.9);
		border-radius: var(--radius);
		box-shadow: var(--box-shadow);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(47, 107, 143, 0.16);
	}
	.card a {
		display: flex;
		align-items: stretch;
		gap: 1.25rem;
		padding: 1.3rem 1.5rem;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.card-content {
		flex: 1;
		min-width: 0;
	}
	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 0.6rem;
	}
	.card:hover .post-title {
		color: var(--accent-dark);
	}
	.cat {
		font-size: 0.75em;
		color: var(--accent-dark);
		background: rgba(var(--accent-soft), 0.6);
		border-radius: 999px;
		padding: 0.2em 0.8em;
		white-space: nowrap;
	}
	.post-title {
		display: block;
		font-size: 1.3em;
		font-weight: 700;
		line-height: 1.35;
	}
	.meta {
		color: rgb(var(--gray));
		font-size: 0.85em;
		white-space: nowrap;
	}
	.excerpt {
		margin: 0.5rem 0 0 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
	}
	.thumbnail {
		align-self: center;
		width: 120px;
		height: 90px;
		flex: 0 0 120px;
		object-fit: cover;
		border-radius: 12px;
		box-shadow: 0 3px 12px rgba(47, 107, 143, 0.16);
	}
	@media (max-width: 520px) {
		.card a {
			gap: 0.85rem;
			padding: 1rem;
		}
		.thumbnail {
			width: 84px;
			height: 84px;
			flex-basis: 84px;
		}
		.excerpt {
			display: -webkit-box;
			overflow: hidden;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
		}
	}
</style>
