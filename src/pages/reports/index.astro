---
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

// 读取 public/reports 下的所有 .html 文件，按「子文件夹 = 分类」自动分组。
// 用法：在 public/reports/ 里建一个分类文件夹（如「个人成长」），把 html 放进去即可。
// 直接放在 public/reports/ 根目录（不在任何子文件夹里）的 html 会归到「其他」。
const reportsDir = path.join(process.cwd(), 'public', 'reports');

type Report = { url: string; title: string; mtime: number };
type Group = { name: string; reports: Report[] };

function readTitle(fullPath: string, fallback: string): string {
	try {
		const html = fs.readFileSync(fullPath, 'utf-8');
		const m = html.match(/<title>([^<]*)<\/title>/i);
		if (m && m[1].trim()) return m[1].trim();
	} catch {}
	return fallback;
}

function encPath(segments: string[]): string {
	return segments.map((s) => encodeURIComponent(s)).join('/');
}

const groups: Group[] = [];
const rootReports: Report[] = [];

if (fs.existsSync(reportsDir)) {
	for (const entry of fs.readdirSync(reportsDir, { withFileTypes: true })) {
		if (entry.isDirectory()) {
			// 一个子文件夹 = 一个分类
			const dirPath = path.join(reportsDir, entry.name);
			const reports: Report[] = fs
				.readdirSync(dirPath)
				.filter((f) => f.toLowerCase().endsWith('.html'))
				.map((file) => {
					const full = path.join(dirPath, file);
					const stat = fs.statSync(full);
					return {
						url: `/reports/${encPath([entry.name, file])}`,
						title: readTitle(full, file.replace(/\.html$/i, '')),
						mtime: stat.mtimeMs,
					};
				})
				.sort((a, b) => b.mtime - a.mtime);
			if (reports.length > 0) groups.push({ name: entry.name, reports });
		} else if (entry.name.toLowerCase().endsWith('.html')) {
			// 根目录里散放的 html
			const full = path.join(reportsDir, entry.name);
			const stat = fs.statSync(full);
			rootReports.push({
				url: `/reports/${encPath([entry.name])}`,
				title: readTitle(full, entry.name.replace(/\.html$/i, '')),
				mtime: stat.mtimeMs,
			});
		}
	}
}

// 按分类名排序；根目录散放的归到「其他」，排在最后
groups.sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'));
if (rootReports.length > 0) {
	rootReports.sort((a, b) => b.mtime - a.mtime);
	groups.push({ name: '其他', reports: rootReports });
}

const total = groups.reduce((n, g) => n + g.reports.length, 0);

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`学习报告 · ${SITE_TITLE}`} description="Vincent 的学习报告合集" />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>学习报告</h1>
				<p>这里是我做的一些学习报告，点开就能看。</p>
			</section>

			{
				total === 0 ? (
					<p class="empty">
						还没有报告。在 <code>public/reports/</code> 下建一个分类文件夹，把生成好的
						<code>.html</code> 放进去就会自动出现在这里。
					</p>
				) : (
					groups.map((g) => (
						<section class="group">
							<h2 class="group-title">{g.name}</h2>
							<ul class="post-list">
								{g.reports.map((r) => (
									<li class="card">
										<a href={r.url}>
											<div class="card-top">
												<span class="cat">报告</span>
												<span class="meta">{dateFmt.format(new Date(r.mtime))}</span>
											</div>
											<span class="post-title">{r.title}</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					))
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}
	.intro h1 {
		font-size: 2.3em;
		margin-bottom: 0.3em;
		color: var(--accent-dark);
	}
	.intro p {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 1.05em;
	}
	.empty {
		color: rgb(var(--gray-dark));
		background: var(--card-bg);
		border: 1px dashed rgba(var(--accent-soft), 1);
		border-radius: var(--radius);
		padding: 1.5rem;
	}
	.group {
		margin-bottom: 2.5rem;
	}
	.group-title {
		font-size: 1.3em;
		color: var(--accent-dark);
		margin: 0 0 1rem 0;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid rgba(var(--accent-soft), 1);
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.card {
		background: var(--card-bg);
		border: 1px solid rgba(var(--accent-soft), 0.9);
		border-radius: var(--radius);
		box-shadow: var(--box-shadow);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(47, 107, 143, 0.16);
	}
	.card a {
		display: block;
		padding: 1.1rem 1.4rem;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}
	.card:hover .post-title {
		color: var(--accent-dark);
	}
	.cat {
		font-size: 0.75em;
		color: var(--accent-dark);
		background: rgba(var(--accent-soft), 0.6);
		border-radius: 999px;
		padding: 0.2em 0.8em;
		white-space: nowrap;
	}
	.post-title {
		display: block;
		font-size: 1.2em;
		font-weight: 700;
		line-height: 1.35;
	}
	.meta {
		color: rgb(var(--gray));
		font-size: 0.85em;
		white-space: nowrap;
	}
</style>
