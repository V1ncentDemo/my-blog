---
import { AUTHOR } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {AUTHOR} · 用心记录每一天</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em 1em;
		margin-top: 2em;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	footer p {
		margin: 0;
	}
</style>
